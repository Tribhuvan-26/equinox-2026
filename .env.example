# Supabase (registrations table, verification status, file storage for
# payment screenshots + UTR proofs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Brevo (transactional email: approval confirmations + private team links)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME="Equinox 2.0"

# Public base URL of the site, used in the private registration links we email
# (team leader / member links). Set explicitly in production, e.g. https://equinox2026.dev. It is
# deliberately NOT read from the request, so a forged Host header can't point a
# link at another site.
SITE_URL=

# Admin verification dashboard
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Payment
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_PAYEE_NAME="Equinox 2026"
