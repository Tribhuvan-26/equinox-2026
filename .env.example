# Supabase (registrations table, verification status, file storage for
# payment screenshots + UTR proofs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Resend (approval confirmation emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Equinox 2026 <registrations@equinox2026.dev>"

# Public base URL of the site, used in emailed links (verify email, reset
# password). Set explicitly in production, e.g. https://equinox2026.dev. It is
# deliberately NOT read from the request, so a forged Host header can't point a
# reset link at another site.
SITE_URL=

# Admin verification dashboard
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# User accounts / teams: signs the user session cookie. Use a long random string
# (e.g. `openssl rand -hex 32`). Required in production.
USER_SESSION_SECRET=

# Payment
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_PAYEE_NAME="Equinox 2026"
